# Build-time only. The static export inlines this value; it is never read at runtime.
# Leave unset to keep the waitlist form disabled (no endpoint, no personal inbox).
NEXT_PUBLIC_WAITLIST_ENDPOINT=https://your-provider.example/your-endpoint

# Base path for the static export. Defaults to /synodos when unset.
# Use a single empty value for a root-path build: NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_BASE_PATH=/synodos
